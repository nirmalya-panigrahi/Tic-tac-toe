rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- basics ----------
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidRoomId(id) {
      return id is string && id.size() == 12 && id.matches('^[A-Z0-9]{12}$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ---------- shape validators ----------
    function isValidPlayerX(p) {
      return p is map && p.size() == 3 &&
        p.keys().hasOnly(['uid', 'name', 'connected']) &&
        p.uid is string && p.uid.size() >= 1 && p.uid.size() <= 128 &&
        p.name is string && p.name.size() >= 1 && p.name.size() <= 20 &&
        p.connected is bool;
    }

    function isValidPlayerO(p) {
      return p is map && p.size() == 3 &&
        p.keys().hasOnly(['uid', 'name', 'connected']) &&
        (p.uid == null || (p.uid is string && p.uid.size() >= 1 && p.uid.size() <= 128)) &&
        p.name is string && p.name.size() <= 20 &&
        p.connected is bool;
    }

    function isValidPlayers(players) {
      return players is map && players.size() == 2 &&
        players.keys().hasOnly(['X', 'O']) &&
        isValidPlayerX(players.X) &&
        isValidPlayerO(players.O);
    }

    function isValidGridShape(grid) {
      return grid is list && grid.size() == 9;
    }

    function isValidGrids(grids) {
      return grids is map && grids.size() == 9 &&
        grids.keys().hasOnly(['0','1','2','3','4','5','6','7','8']) &&
        isValidGridShape(grids['0']) && isValidGridShape(grids['1']) &&
        isValidGridShape(grids['2']) && isValidGridShape(grids['3']) &&
        isValidGridShape(grids['4']) && isValidGridShape(grids['5']) &&
        isValidGridShape(grids['6']) && isValidGridShape(grids['7']) &&
        isValidGridShape(grids['8']);
    }

    function isEmptyBoard(grids, gridWins) {
      return grids['0'].hasOnly([null]) && grids['1'].hasOnly([null]) &&
        grids['2'].hasOnly([null]) && grids['3'].hasOnly([null]) &&
        grids['4'].hasOnly([null]) && grids['5'].hasOnly([null]) &&
        grids['6'].hasOnly([null]) && grids['7'].hasOnly([null]) &&
        grids['8'].hasOnly([null]) && gridWins.hasOnly([null]);
    }

    function isValidLastMove(m) {
      return m == null || (
        m is map && m.size() == 2 &&
        m.keys().hasOnly(['gridIndex', 'cellIndex']) &&
        m.gridIndex is int && m.gridIndex >= 0 && m.gridIndex <= 8 &&
        m.cellIndex is int && m.cellIndex >= 0 && m.cellIndex <= 8
      );
    }

    function isValidLogs(logs) {
      return logs is list && logs.size() <= 20 &&
        (logs.size() == 0 || (logs[0] is string && logs[0].size() <= 300));
    }

    // Full validation: used on CREATE only.
    function isValidGameRoom(data) {
      return data.keys().hasAll([
          'roomCode', 'status', 'createdAt', 'currentTurn', 'nextGridIndex',
          'grids', 'gridWins', 'winner', 'lastMove', 'players', 'logs'
        ]) &&
        data.keys().hasOnly([
          'roomCode', 'status', 'createdAt', 'currentTurn', 'nextGridIndex',
          'grids', 'gridWins', 'winner', 'lastMove', 'players', 'logs'
        ]) &&
        isValidRoomId(data.roomCode) &&
        data.status in ['waiting', 'playing', 'finished'] &&
        data.createdAt is timestamp &&
        data.currentTurn in ['X', 'O'] &&
        (data.nextGridIndex == null ||
          (data.nextGridIndex is int && data.nextGridIndex >= 0 && data.nextGridIndex <= 8)) &&
        isValidGrids(data.grids) &&
        data.gridWins is list && data.gridWins.size() == 9 &&
        data.gridWins.hasOnly(['X', 'O', 'DRAW', null]) &&
        (data.winner == null || data.winner in ['X', 'O', 'DRAW']) &&
        isValidLastMove(data.lastMove) &&
        isValidPlayers(data.players) &&
        isValidLogs(data.logs);
    }

    // ---------- game logic ----------
    function hasWon(b, p) {
      return (b[4] == p && (
          (b[0] == p && b[8] == p) ||
          (b[2] == p && b[6] == p) ||
          (b[1] == p && b[7] == p) ||
          (b[3] == p && b[5] == p)
        )) ||
        (b[0] == p && ((b[1] == p && b[2] == p) || (b[3] == p && b[6] == p))) ||
        (b[8] == p && ((b[6] == p && b[7] == p) || (b[2] == p && b[5] == p)));
    }

    function hasEmpty(b) {
      return b[0] == null || b[1] == null || b[2] == null ||
        b[3] == null || b[4] == null || b[5] == null ||
        b[6] == null || b[7] == null || b[8] == null;
    }

    // Two 9-element lists are identical except possibly at index i.
    function sameExcept(a, b, i) {
      return (i == 0 || a[0] == b[0]) && (i == 1 || a[1] == b[1]) &&
        (i == 2 || a[2] == b[2]) && (i == 3 || a[3] == b[3]) &&
        (i == 4 || a[4] == b[4]) && (i == 5 || a[5] == b[5]) &&
        (i == 6 || a[6] == b[6]) && (i == 7 || a[7] == b[7]) &&
        (i == 8 || a[8] == b[8]);
    }

    function isValidMoveTransition(inc, ext) {
      let g = inc.lastMove.gridIndex;
      let c = inc.lastMove.cellIndex;
      let k = string(g);
      let turn = ext.currentTurn;
      let incGrid = inc.grids[k];
      let extGrid = ext.grids[k];
      let gWin = inc.gridWins[g];
      let subWon = hasWon(incGrid, turn);
      let globalWon = hasWon(inc.gridWins, turn);

      return
        // the move is legal in the existing state
        ext.winner == null &&
        ext.gridWins[g] == null &&
        (ext.nextGridIndex == null || ext.nextGridIndex == g ||
          ext.gridWins[ext.nextGridIndex] != null) &&
        extGrid[c] == null &&
        // exactly one cell in one grid changed, to the mover's mark
        isValidGridShape(incGrid) &&
        incGrid[c] == turn &&
        inc.grids.diff(ext.grids).affectedKeys().hasOnly([k]) &&
        sameExcept(incGrid, extGrid, c) &&
        // gridWins: same size, only index g may change
        inc.gridWins.size() == 9 &&
        sameExcept(inc.gridWins, ext.gridWins, g) &&
        // sub-grid result
        (gWin == null
          ? (!subWon && hasEmpty(incGrid))
          : (gWin == turn
              ? subWon
              : (gWin == 'DRAW' && !subWon && !hasEmpty(incGrid)))) &&
        // overall result
        (gWin == null
          ? (inc.winner == null && inc.status == 'playing')
          : (inc.winner == turn
              ? (inc.status == 'finished' && globalWon)
              : (inc.winner == 'DRAW'
                  ? (inc.status == 'finished' && !globalWon && !hasEmpty(inc.gridWins))
                  : (inc.winner == null && inc.status == 'playing' &&
                     !globalWon && hasEmpty(inc.gridWins))))) &&
        // next forced grid, and turn flips
        (inc.gridWins[c] != null ? inc.nextGridIndex == null : inc.nextGridIndex == c) &&
        inc.currentTurn == (turn == 'X' ? 'O' : 'X');
    }

    // ---------- actions ----------
    function isJoinAction() {
      let ext = existing();
      let inc = incoming();
      return ext.status == 'waiting' &&
        ext.players.O.uid == null &&
        inc.diff(ext).affectedKeys().hasOnly(['players', 'status', 'logs']) &&
        inc.status == 'playing' &&
        inc.players.size() == 2 &&
        inc.players.X == ext.players.X &&
        isValidPlayerO(inc.players.O) &&
        inc.players.O.uid == request.auth.uid &&
        inc.players.O.name.size() >= 1 &&
        inc.players.O.connected == true &&
        isValidLogs(inc.logs);
    }

    function isMoveAction() {
      let ext = existing();
      let inc = incoming();
      return ext.status == 'playing' &&
        ext.players.O.uid != null &&
        request.auth.uid ==
          (ext.currentTurn == 'X' ? ext.players.X.uid : ext.players.O.uid) &&
        inc.diff(ext).affectedKeys().hasOnly([
          'currentTurn', 'nextGridIndex', 'grids', 'gridWins',
          'winner', 'status', 'lastMove', 'logs'
        ]) &&
        inc.lastMove != null &&
        isValidLastMove(inc.lastMove) &&
        isValidLogs(inc.logs) &&
        isValidMoveTransition(inc, ext);
    }

    function isPresenceAction() {
      let ext = existing();
      let inc = incoming();
      let uid = request.auth.uid;
      return inc.diff(ext).affectedKeys().hasOnly(['players']) &&
        inc.players.size() == 2 &&
        (
          (uid == ext.players.X.uid &&
            inc.players.O == ext.players.O &&
            isValidPlayerX(inc.players.X) &&
            inc.players.X.uid == ext.players.X.uid &&
            inc.players.X.name == ext.players.X.name) ||
          (ext.players.O.uid != null && uid == ext.players.O.uid &&
            inc.players.X == ext.players.X &&
            isValidPlayerO(inc.players.O) &&
            inc.players.O.uid == ext.players.O.uid &&
            inc.players.O.name == ext.players.O.name)
        );
    }

    function isRematchAction() {
      let ext = existing();
      let inc = incoming();
      let uid = request.auth.uid;
      return ext.status == 'finished' &&
        ext.players.O.uid != null &&
        (uid == ext.players.X.uid || uid == ext.players.O.uid) &&
        inc.diff(ext).affectedKeys().hasOnly([
          'status', 'currentTurn', 'nextGridIndex', 'grids',
          'gridWins', 'winner', 'lastMove', 'logs'
        ]) &&
        inc.status == 'playing' &&
        inc.currentTurn == 'X' &&
        inc.nextGridIndex == null &&
        inc.winner == null &&
        inc.lastMove == null &&
        isValidGrids(inc.grids) &&
        inc.gridWins is list && inc.gridWins.size() == 9 &&
        isEmptyBoard(inc.grids, inc.gridWins) &&
        isValidLogs(inc.logs);
    }

    // ---------- rooms ----------
    match /rooms/{roomId} {
      allow get: if isVerifiedUser() && isValidRoomId(roomId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidRoomId(roomId) &&
        isValidGameRoom(incoming()) &&
        incoming().roomCode == roomId &&
        incoming().status == 'waiting' &&
        incoming().currentTurn == 'X' &&
        incoming().nextGridIndex == null &&
        incoming().winner == null &&
        incoming().lastMove == null &&
        isEmptyBoard(incoming().grids, incoming().gridWins) &&
        incoming().createdAt == request.time &&
        incoming().players.X.uid == request.auth.uid &&
        incoming().players.O.uid == null;

      allow update: if isVerifiedUser() &&
        isValidRoomId(roomId) &&
        (isJoinAction() || isMoveAction() || isPresenceAction() || isRematchAction());

      allow delete: if false;
    }
  }
}
